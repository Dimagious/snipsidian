{
    "name": "snipsidian-integration",
    "private": true,
    "type": "module",
    "description": "Integration layer (B-219): smoke tests inside a real Obsidian. Standalone project, not a workspace, so root installs and CI never pull it in.",
    "scripts": {
        "it": "cd .. && vitest run --config integration/vitest.config.ts --project desktop",
        "it:matrix": "cd .. && node integration/run-matrix.mjs",
        "it:android": "cd .. && vitest run --config integration/vitest.config.ts --project android",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint --config eslint.config.js ."
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@types/node": "22.20.5",
        "eslint": "9.39.5",
        "obsidian": "1.13.1",
        "obsidian-integration-testing": "17.9.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.66.0",
        "vitest": "5.1.0"
    }
}
